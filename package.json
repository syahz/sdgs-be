{
  "name": "be-sdgs",
  "version": "1.0.0",
  "description": "SDGs Dashboard Backend — Express + Prisma + PostgreSQL",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "seed:config": "ts-node prisma/seed-sdg-config-2026.ts",
    "check:config": "ts-node scripts/test-config-registry.ts && ts-node scripts/test-config-cache.ts",
    "check:parity": "ts-node scripts/verify-scoring-parity.ts",
    "check:drift": "ts-node scripts/check-points-drift.ts",
    "check:errors": "ts-node --transpile-only scripts/check-error-mapping.ts",
    "check:deps": "ts-node --transpile-only scripts/check-deps-security.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overridesReason": "Semua HIGH di npm audit datang dari dependensi transitif yang di-pin versi rentan oleh paket induknya. Override memaksa versi yang sudah ditambal tanpa menunggu rilis induk. ip-address (via express-rate-limit) = GHSA-mwp4-54f8-5fhr, bypass key rate-limit. nanoid (via sanitize-html>postcss) = GHSA-2v37-7h3g-55p8, loop tak berujung. deepmerge-ts (via prisma CLI, devDep) = GHSA-ggr8-5vv4-36mx.",
  "overrides": {
    "ip-address": "^10.5.0",
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "sanitize-html": "^2.17.6",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
