DATABASE_URL=postgresql://user:password@localhost:5432/sdgs_db
PORT=4010
FRONTEND_URL=http://localhost:3010
BASE_URL=http://localhost:4010
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
IDLE_TIMEOUT_SECONDS=1800

# ── Keycloak / IAM Universitas (OIDC) ──────────────────────────────────────
# SATU-SATUNYA jalur login. Tidak ada login email+password di sistem ini.
# Issuer = URL realm. Endpoint auth/token/userinfo diturunkan otomatis.
KEYCLOAK_ISSUER_URL=https://iam.ub.ac.id/auth/realms/ub
KEYCLOAK_CLIENT_ID=your_client_id
KEYCLOAK_CLIENT_SECRET=your_client_secret
# WAJIB sama persis dengan "Valid Redirect URI" yang di-whitelist di Keycloak.
#   dev : http://localhost:4010/api/auth/keycloak/callback
#   prod: https://<domain-be>/api/auth/keycloak/callback
KEYCLOAK_REDIRECT_URI=http://localhost:4010/api/auth/keycloak/callback

# ── Seeder ─────────────────────────────────────────────────────────────────
# Email super admin awal, pisah koma. Tanpa default: seeder melewati pembuatan
# super admin bila kosong. Email wajib sama persis dengan akun IAM UB kalau
# jalur SSO mau dipakai.
SEED_SUPER_ADMIN_EMAILS=
# Opsional, minimal 8 karakter. Diisi = akun bisa login email+password.
# Dikosongkan = akun SSO-only. Jangan commit nilainya; hapus setelah seeding.
SEED_SUPER_ADMIN_PASSWORD=

# ── Lain-lain ──────────────────────────────────────────────────────────────
COOKIE_DOMAIN=
NODE_ENV=development
LOG_DIR=../logs
# Naikkan sementara saat audit/scan (mis. 100000), kembalikan setelah selesai.
# RATE_LIMIT_GLOBAL=300
